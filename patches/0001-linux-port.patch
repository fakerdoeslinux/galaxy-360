+    NebulaPaneKit* mKitText;    // InformationWindow: the game's message font
+    NebulaPaneKit* mKitWindow;  // SysInfoWindowMini: the window with a ring
+    Ui::Pane* mGroup;
+    Ui::Window* mPanel;
+    Ui::TextBox* mValue;
+    f32 mScaleX;
+    f32 mWidth;
+    f32 mHeight;
+    u32 mShownTenths;
+    bool mReady;
+};
