+// NEBULA_OPTION_FPS: the presents the swap chain got over the renderer's last one-second window, the measure the menu's
+// FRAME RATE row shows (host_window::measured_present_hz), with frame generation's extra presents counted in. Tenths,
+// so 59.9 and 60.0 differ. The renderer counts every present, so this is the picture's rate on the display, not the
+// game's step rate: with interpolation or a frame-rate limit above 60 they differ by design.
+uint32_t sampled_fps_tenths() {
+#if defined(NEBULA_HOST_RENDERER)
+    double hz = galaxy::render::host_window::measured_present_hz.load(std::memory_order_relaxed);
+    if (galaxy::render::frame_generation_running()) {
+        hz *= static_cast<double>(galaxy::render::host_window::upscaler_caps().frames_presented);
+    }
+    if (!(hz > 0.0)) {
+        return 0u;
+    }
+    return static_cast<uint32_t>(hz * 10.0 + 0.5);
+#else
+    return 0;
+#endif
+}
