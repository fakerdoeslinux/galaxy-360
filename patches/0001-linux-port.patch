+// The settings menu's sounds: `data/menu-sounds/<role>.wav` loaded once, mixed into the output frame (ui_sounds.h).
+//
+// A clip is held as interleaved stereo floats at its own rate, played by linear interpolation from the game's thread to
+// the device's. The sounds are a few hundred milliseconds long, so the interpolation's error stays under a millisecond
+// of delay at any device rate, and there is no filter to ring on a blip.
+#include "galaxy/ui_sounds.h"
+
+#include "galaxy/runtime_settings.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace galaxy::host {
+namespace {
+
+// One per role, in UiSoundId's order. The loader looks for `<role>.wav`.
+constexpr const char* kRoleNames[] = {"focus", "select", "page", "open", "close", "ok"};
+static_assert(std::size(kRoleNames) == kUiSoundCount, "one file name per role");
+
+// Queued and sounding at once. Radial menu blips never come close; a stuck queue is capped rather than growing.
+constexpr std::size_t kVoices = 8;
+
+constexpr float kSfxGain = 1.0f;  // the effects bus is already `audio.sfx`; the clip plays at its own level
+
+struct Clip {
+    std::vector<float> samples;  // interleaved stereo
+    std::uint32_t rate = 0;
+    std::uint32_t frames = 0;
+
+    [[nodiscard]] bool ok() const { return rate != 0 && frames != 0; }
+};
+
+std::uint32_t read_le32(const unsigned char* p) {
+    return static_cast<std::uint32_t>(p[0]) | static_cast<std::uint32_t>(p[1]) << 8 |
+           static_cast<std::uint32_t>(p[2]) << 16 | static_cast<std::uint32_t>(p[3]) << 24;
+}
+
+std::uint16_t read_le16(const unsigned char* p) {
+    return static_cast<std::uint16_t>(static_cast<std::uint16_t>(p[0]) | static_cast<std::uint16_t>(p[1]) << 8);
+}
+
+// A RIFF/WAVE file's `data` chunk as interleaved stereo floats. False with `why` set for anything but 8- or 16-bit PCM
+// (the menu's files are 16-bit; anything else is left out rather than resampled wrong).
+bool read_wav(const std::filesystem::path& path, Clip* pClip, std::string* pWhy) {
+    std::ifstream file(path, std::ios::binary);
+    if (!file) {
+        *pWhy = "cannot be opened";
+        return false;
+    }
+    std::vector<unsigned char> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    if (bytes.size() < 12u || std::memcmp(bytes.data(), "RIFF", 4) != 0 || std::memcmp(bytes.data() + 8, "WAVE", 4) != 0) {
+        *pWhy = "is not a RIFF/WAVE file";
+        return false;
+    }
+    unsigned format = 0;
+    unsigned channels = 0;
+    unsigned bits = 0;
+    std::uint32_t rate = 0;
+    const unsigned char* pData = nullptr;
+    std::size_t dataBytes = 0;
+    std::size_t at = 12u;
+    while (at + 8u <= bytes.size()) {
+        const unsigned char* const pChunk = bytes.data() + at;
+        const std::uint32_t size = read_le32(pChunk + 4);
+        const std::size_t body = at + 8u;
+        if (body > bytes.size()) {
+            break;
+        }
+        const std::size_t available = std::min<std::size_t>(size, bytes.size() - body);
+        if (std::memcmp(pChunk, "fmt ", 4) == 0 && available >= 16u) {
+            format = read_le16(bytes.data() + body);
+            channels = read_le16(bytes.data() + body + 2);
+            rate = read_le32(bytes.data() + body + 4);
+            bits = read_le16(bytes.data() + body + 14);
+            // WAVE_FORMAT_EXTENSIBLE: the real format is the first two bytes of the sub-format's GUID.
+            if (format == 0xFFFEu && available >= 26u) {
+                format = read_le16(bytes.data() + body + 24);
+            }
+        } else if (std::memcmp(pChunk, "data", 4) == 0) {
+            pData = bytes.data() + body;
+            dataBytes = available;
+        }
+        at = body + available + (available & 1u);  // chunks sit on even boundaries
+    }
+    if (format != 1u) {
+        *pWhy = "is not PCM";
+        return false;
+    }
+    if (channels != 1u && channels != 2u) {
+        *pWhy = "has more than two channels";
+        return false;
+    }
+    if (bits != 8u && bits != 16u) {
+        *pWhy = "is not 8- or 16-bit";
+        return false;
+    }
+    if (pData == nullptr || rate == 0u) {
+        *pWhy = "has no samples";
+        return false;
+    }
+    const std::size_t bytesPerSample = bits / 8u;
+    const std::uint32_t frames = static_cast<std::uint32_t>(dataBytes / (bytesPerSample * channels));
+    if (frames == 0u) {
+        *pWhy = "has no samples";
+        return false;
+    }
+    pClip->rate = rate;
+    pClip->frames = frames;
+    pClip->samples.assign(static_cast<std::size_t>(frames) * 2u, 0.0f);
+    for (std::uint32_t i = 0; i < frames; ++i) {
+        for (unsigned channel = 0; channel < 2u; ++channel) {
+            const unsigned from = channels == 2u ? channel : 0u;
+            const unsigned char* const pSample = pData + (static_cast<std::size_t>(i) * channels + from) * bytesPerSample;
+            const float value = bits == 16u
+                ? static_cast<float>(static_cast<std::int16_t>(read_le16(pSample))) / 32768.0f
+                : (static_cast<float>(pSample[0]) - 128.0f) / 128.0f;
+            pClip->samples[static_cast<std::size_t>(i) * 2u + channel] = value;
+        }
+    }
+    return true;
+}
+
+}  // namespace
+
+struct UiSounds::State {
+    Clip clips[kUiSoundCount];
+    char loaded[64] = {};
+
+    // The device's thread: queued plays wait here until its next frame takes them.
+    std::mutex lock;
+    std::vector<std::uint32_t> queued;
+
+    struct Voice {
+        const Clip* pClip = nullptr;
+        double position = 0.0;  // in the clip's own frames
+        bool playing = false;
+        std::uint64_t started = 0;
+    };
+    Voice voices[kVoices];
+    std::uint64_t started = 0;
+    // Set when the device changes rate: every voice's step is worked out per frame, so nothing to redo.
+};
+
+UiSounds::UiSounds() : state_(std::make_unique<State>()) {}
+UiSounds::~UiSounds() = default;
+
+void UiSounds::load(const char* folder) {
+    State& s = *state_;
+    std::filesystem::path dir;
+    if (folder != nullptr && folder[0] != '\0') {
+        dir = std::filesystem::path(folder);
+    } else {
+        dir = galaxy::runtime_settings_folder() / "menu-sounds";
+    }
+    std::string found;
+    for (std::uint32_t id = 0; id < kUiSoundCount; ++id) {
+        Clip& rClip = s.clips[id];
+        rClip = Clip{};
+        const std::filesystem::path path = dir / (std::string(kRoleNames[id]) + ".wav");
+        std::error_code error;
+        if (!std::filesystem::is_regular_file(path, error)) {
+            continue;
+        }
+        std::string why;
+        if (!read_wav(path, &rClip, &why)) {
+            std::fprintf(stderr, "[audio] the menu sound %s %s: left out\n", path.string().c_str(), why.c_str());
+            continue;
+        }
+        if (!found.empty()) {
+            found += ' ';
+        }
+        found += kRoleNames[id];
+    }
+    std::snprintf(s.loaded, sizeof(s.loaded), "%s", found.c_str());
+}
+
+const char* UiSounds::loaded() const {
+    return state_->loaded;
+}
+
+bool UiSounds::play(std::uint32_t id) {
+    if (id >= kUiSoundCount || !state_->clips[id].ok()) {
+        return false;
+    }
+    const std::lock_guard<std::mutex> guard(state_->lock);
+    if (state_->queued.size() >= kVoices) {
+        return true;  // already as many waiting as can sound; the newest tick is the one that matters
+    }
+    state_->queued.push_back(id);
+    return true;
+}
+
+void UiSounds::mix(float* out, std::size_t frames, std::uint32_t rate, float gain_start, float gain_end) {
+    State& s = *state_;
+    if (frames == 0u || rate == 0u) {
+        return;
+    }
+    {
+        const std::lock_guard<std::mutex> guard(s.lock);
+        for (const std::uint32_t id : s.queued) {
+            State::Voice* pVoice = nullptr;
+            for (State::Voice& rVoice : s.voices) {
+                if (!rVoice.playing) {
+                    pVoice = &rVoice;
+                    break;
+                }
+            }
+            if (pVoice == nullptr) {
+                // Full: the oldest gives way, so that the newest press is always heard.
+                pVoice = &s.voices[0];
+                for (State::Voice& rVoice : s.voices) {
+                    if (rVoice.started < pVoice->started) {
+                        pVoice = &rVoice;
+                    }
+                }
+            }
+            pVoice->pClip = &s.clips[id];
+            pVoice->position = 0.0;
+            pVoice->playing = true;
+            pVoice->started = ++s.started;
+        }
+        s.queued.clear();
+    }
+    for (State::Voice& rVoice : s.voices) {
+        if (!rVoice.playing || rVoice.pClip == nullptr) {
+            continue;
+        }
+        const Clip& rClip = *rVoice.pClip;
+        const double step = static_cast<double>(rClip.rate) / static_cast<double>(rate);
+        const std::size_t last = rClip.frames - 1u;
+        for (std::size_t i = 0; i < frames; ++i) {
+            if (rVoice.position >= static_cast<double>(last)) {
+                rVoice.playing = false;
+                break;
+            }
+            const auto whole = static_cast<std::size_t>(rVoice.position);
+            const float fraction = static_cast<float>(rVoice.position - static_cast<double>(whole));
+            const std::size_t next = whole + 1u < rClip.frames ? whole + 1u : whole;
+            const float gain = gain_start + (gain_end - gain_start) * static_cast<float>(i) / static_cast<float>(frames);
+            const float scale = gain * kSfxGain;
+            for (unsigned channel = 0; channel < 2u; ++channel) {
+                const float a = rClip.samples[whole * 2u + channel];
+                const float b = rClip.samples[next * 2u + channel];
+                out[i * 2u + channel] += (a + (b - a) * fraction) * scale;
+            }
+            rVoice.position += step;
+        }
+        if (rVoice.position >= static_cast<double>(last)) {
+            rVoice.playing = false;
+        }
+    }
+}
+
