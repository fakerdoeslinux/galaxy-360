diff --git a/native/petari/src/Game/Screen/NebulaFpsCounter.cpp b/native/petari/src/Game/Screen/NebulaFpsCounter.cpp
new file mode 100644
index 0000000..9b4d357
--- /dev/null
+++ b/native/petari/src/Game/Screen/NebulaFpsCounter.cpp
@@ -0,0 +1,149 @@
+#include "Game/Screen/NebulaFpsCounter.hpp"
+#include <nebula_module.h>
+
+#include "Game/Screen/LayoutManager.hpp"
+#include "Game/Screen/NebulaPaneKit.hpp"
+#include "Game/Screen/NebulaUi.hpp"
+#include "Game/System/NebulaHost.hpp"
+#include <Game/Ui/Layout.hpp>
+#include <Game/Ui/Pane.hpp>
+#include <Game/Ui/TextBox.hpp>
+#include <Game/Ui/Window.hpp>
+#include <cstring>
+
+namespace {
+    // In the screen's units (the canvas is 456 high at every resolution): the number's size, the window's padding, its
+    // distance from the screen's top left corner, its corner radius, and the width the measure may take before the
+    // writer breaks the line (it never does: the readout is one short line).
+    const f32 cSize = 14.0f;
+    const f32 cPaddingX = 9.0f;
+    const f32 cPaddingY = 5.0f;
+    const f32 cMargin = 12.0f;
+    const f32 cRadius = 8.0f;
+    const f32 cMeasureLimit = 160.0f;
+
+    // The menus' blues: the deep navy window, its sky rim, and the readout in near white with a cool foot.
+    const u32 cPanelFill = 0x0B1F3ACA;
+    const u32 cPanelRing = 0x63B8F0FF;
+    const u32 cTextTop = 0xFFFFFFFF;
+    const u32 cTextBottom = 0xD8E9FAFF;
+}  // namespace
+
+NebulaFpsCounter::NebulaFpsCounter()
+    : LayoutActor("NebulaFpsCounter", true), mKitText(nullptr), mKitWindow(nullptr), mGroup(nullptr), mPanel(nullptr),
+      mValue(nullptr), mScaleX(1.0f), mWidth(0.0f), mHeight(0.0f), mShownTenths(0xFFFFFFFFu), mReady(false) {
+}
+
+void NebulaFpsCounter::init(const TableIter& /*rIter*/) {
+    initLayoutManager("InformationWindow", 0);
+    LayoutManager* pManager = getLayoutManager();
+    static const char cLayoutName[] = "NebulaFpsCounter";
+    delete[] pManager->mLayoutName;
+    pManager->mLayoutName = new char[sizeof(cLayoutName)];
+    memcpy(pManager->mLayoutName, cLayoutName, sizeof(cLayoutName));
+
+    Ui::Pane* pRoot = pManager->mLayout->mpRootPane;
+    mKitText = new NebulaPaneKit();
+    mKitWindow = new NebulaPaneKit();
+    if (pRoot == nullptr || !mKitText->init(pManager->mLayoutHolder, "InformationWindow", pManager->mLayout)) {
+        nebula_log("NebulaFpsCounter: no InformationWindow layout\n");
+        return;
+    }
+    // The window is the game's ringed one; without it the message font's own information window stands in.
+    const bool ringed = mKitWindow->init("SysInfoWindowMini", pManager->mLayout);
+    // The information window's own panes stay hidden: only the readout shows.
+    for (Ui::Pane* pChild : pRoot->GetChildList()) {
+        pChild->SetVisible(false);
+    }
+    mGroup = NebulaUi::makeGroup(pRoot, "NbFpsGroup");
+    if (mGroup == nullptr) {
+        return;
+    }
+    const NebulaUi::Kits kits = {mKitText, ringed ? mKitWindow : mKitText, nullptr};
+    mPanel = NebulaUi::makeWindow(kits, mGroup, "NbFpsPanel");
+    if (mPanel != nullptr) {
+        NebulaUi::paint(mPanel, cPanelFill, cPanelRing);
+    }
+    mValue = NebulaUi::makeText(kits, mGroup, "NbFpsValue", 16);
+    if (mValue == nullptr) {
+        return;
+    }
+    NebulaUi::setTextStyle(mValue, cSize, cTextTop, cTextBottom, 4);
+    NebulaUi::setText(mValue, u"0 FPS");
+    mGroup->SetVisible(false);
+    mReady = true;
+    LayoutActor::appear();
+}
+
+// "120 FPS" from the host's measure, in tenths of a frame a second, rounded to the frame.
+void NebulaFpsCounter::setValue(u32 tenths) {
+    char16_t digits[12];
+    u32 count = 0;
+    u32 value = (tenths + 5u) / 10u;
+    do {
+        digits[count++] = static_cast< char16_t >(u'0' + value % 10u);
+        value /= 10u;
+    } while (value != 0u && count < sizeof(digits) / sizeof(digits[0]));
+
+    char16_t text[20];
+    u32 length = 0;
+    while (count > 0 && length < 12) {
+        text[length++] = digits[--count];
+    }
+    static const char16_t cSuffix[] = u" FPS";
+    for (u32 i = 0; cSuffix[i] != 0 && length < 19; i++) {
+        text[length++] = cSuffix[i];
+    }
+    text[length] = 0;
+    NebulaUi::setText(mValue, text);
+}
+
+// The window and its number, in screen units: pinned to the screen's top left corner at any aspect ratio.
+void NebulaFpsCounter::place() {
+    mGroup->mScale = Vec2f(mScaleX, 1.0f);
+    NebulaUi::setTextStyle(mValue, cSize, cTextTop, cTextBottom, 4);
+    f32 textWidth = 0.0f;
+    f32 textHeight = 0.0f;
+    NebulaUi::measure(mValue, cMeasureLimit, &textWidth, &textHeight);
+    const f32 panelWidth = textWidth + 2.0f * cPaddingX;
+    const f32 panelHeight = textHeight + 2.0f * cPaddingY;
+    const f32 x = -mWidth * 0.5f + cMargin + panelWidth * 0.5f;
+    const f32 y = mHeight * 0.5f - cMargin - panelHeight * 0.5f;
+    if (mPanel != nullptr) {
+        NebulaUi::shape(mPanel, x, y, panelWidth, panelHeight, cRadius);
+    }
+    NebulaUi::setAnchor(mValue, 4);
+    mValue->mTranslate = Vec3f(x, NebulaUi::textCentre(y, cSize), 0.0f);
+}
+
+void NebulaFpsCounter::update() {
+    if (!mReady) {
+        return;
+    }
+    const u32 tenths = NebulaHost::option(NEBULA_OPTION_FPS);
+    // No measure yet (the renderer's first second): the window waits rather than showing a zero it would have to take
+    // back.
+    const bool shown = NebulaHost::option(NEBULA_OPTION_SHOW_FPS) != 0u && tenths != 0u;
+    mGroup->SetVisible(shown);
+    if (!shown) {
+        return;
+    }
+    f32 scaleX, width, height;
+    NebulaUi::readScreen(&scaleX, &width, &height);
+    if (scaleX != mScaleX || width != mWidth || height != mHeight || tenths != mShownTenths) {
+        mScaleX = scaleX;
+        mWidth = width;
+        mHeight = height;
+        mShownTenths = tenths;
+        setValue(tenths);
+        place();
+    }
+    movement();
+    calcAnim();
+}
+
+void NebulaFpsCounter::drawOnTop() const {
+    if (mReady) {
+        draw();
+    }
+}
