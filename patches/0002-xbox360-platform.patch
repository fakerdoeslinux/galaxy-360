--- /dev/null
+++ b/platform/xbox360/xenos_device.h
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Xenos: the console's device, its 10 MB of EDRAM, the tile a scene is drawn into, the resolve, and the present that
+// hands the frame to the scaler. The renderer above this (runtime/src/render/) keeps its own command list; this is the
+// device and the swap chain under it, the same role D3D12's device and Vulkan's context play on the other platforms.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+#if defined(NEBULA_XBOX360)
+#include <d3d9.h>
+#endif
+
+namespace galaxy::host::x360 {
+
+// What a texture looks like to the uploader: the texel format the frame's shaders sample, the size, and the mips.
+struct TextureDesc {
+    enum class Format : std::uint8_t { Bgra8, Bc1, Bc2, Bc3, Rgba8, R8, Dxt5 };
+    Format format = Format::Bgra8;
+    std::uint32_t width = 0;
+    std::uint32_t height = 0;
+    std::uint32_t mips = 1;
+    bool render_target = false;
+};
+
+class XenosDevice {
+public:
+    XenosDevice();
+    ~XenosDevice();
+    XenosDevice(const XenosDevice&) = delete;
+    XenosDevice& operator=(const XenosDevice&) = delete;
+
+    // Creates the device, the 1280x720 back buffer, the depth buffer and the resolve target the scaler is shown.
+    bool open();
+    void close();
+
+    [[nodiscard]] bool open_ok() const noexcept;
+
+#if defined(NEBULA_XBOX360)
+    [[nodiscard]] IDirect3DDevice9* device() const noexcept;
+    [[nodiscard]] IDirect3DTexture9* resolved_texture() const noexcept;
+#endif
+
+    // A scene larger than the EDRAM holds (colour and depth at 2x multisampling are 14.7 MB of it) is drawn in
+    // predicated tiles: the renderer calls these around its scene passes and the driver clips each one for it.
+    void begin_scene_tiles();
+    void end_scene_tiles();
+
+    // The multisampled target's resolve into `resolved_texture`, then the scaler's present. `vsync` is the frame's
+    // rate tied to the panel's; a 60 Hz title never tears and its frame budget is the period.
+    bool resolve_and_present(bool vsync);
+
+    // A texture the game's own material path can draw: format, size, mips, and the 32x32 tiled layout the Xenos wants
+    // (XGSwizzleRect writes the rows into it; the driver owns the block order).
+#if defined(NEBULA_XBOX360)
+    [[nodiscard]] IDirect3DTexture9* create_texture(const TextureDesc& desc) const;
+    // `rows` is the picture's rows, tightly packed, big-endian, as the cooker wrote them (tools/xbox360/cook.py).
+    bool upload_texture(IDirect3DTexture9* pTexture, const TextureDesc& desc, const void* rows, std::uint32_t pitch) const;
+#endif
+
+    // The device's own wait: the render queue empty before the next frame's targets are rewritten.
+    void wait_idle();
+
+    // Frames the device presented since open(), for the frame limiter and the diagnostics.
+    [[nodiscard]] std::uint64_t presents() const noexcept;
+
+private:
+    struct State;
+    std::unique_ptr<State> state_;
+};
+
+// The device as the renderer's host services see it (runtime/src/render/render_api.cpp's present path).
+[[nodiscard]] XenosDevice& xenos();
+
+}  // namespace galaxy::host::x360
