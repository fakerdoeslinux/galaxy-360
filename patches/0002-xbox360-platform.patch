+// SPDX-License-Identifier: GPL-3.0-only
+// The console's frame, as the D3D9 renderer and the window share it: the device one frame is drawn into, and the
+// present that swaps it onto the scaler. The window owns both; the renderer only asks.
+#pragma once
+
+#if defined(NEBULA_XBOX360)
+
+struct IDirect3DDevice9;
+
+namespace galaxy::render::host_window {
+
+// The device open_game_window made. Null before the window opens and after it closes.
+[[nodiscard]] IDirect3DDevice9* window_device();
+
+// The frame is drawn: waits for the display, then swaps. Called once a frame by the renderer's present.
+void present_frame();
+
+}  // namespace galaxy::render::host_window
+
+#endif  // NEBULA_XBOX360
diff --git a/platform/xbox360/xbox360_tuning.h b/platform/xbox360/xbox360_tuning.h
new file mode 100644
index 0000000..361cc23
--- /dev/null
+++ b/platform/xbox360/xbox360_tuning.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// The numbers the Xbox 360 build runs by: what the console gives, how its 512 MB is split between the port's caches,
+// and what one frame of a 60 Hz game may spend. Everything here is a constant of the machine or a budget the port
+// keeps; the player's own settings stay in runtime_settings.ini.
+#pragma once
+
+#include <cstdint>
+
+namespace galaxy::host::x360 {
+
+// ---- The machine -------------------------------------------------------------------------------------------------
+
+inline constexpr std::uint32_t kTimeBaseHz = 50000000u;  // Xenon's time base, all three cores and the GPU
+inline constexpr std::uint32_t kHardwareThreads = 6u;    // three cores, two threads each
+inline constexpr std::uint32_t kConsoleMemoryBytes = 512u * 1024u * 1024u;
+// What a title gets: the hypervisor and the kernel keep the rest. The dashboard's guide is not resident in a title.
+inline constexpr std::uint32_t kUsableMemoryBytes = 480u * 1024u * 1024u;
+inline constexpr std::uint32_t kEdramBytes = 10u * 1024u * 1024u;  // the daughter die's framebuffer
+// One predicated tile, at 720p: half the frame's height, 1280x360, 2x multisampled 32-bit colour plus 2x multisampled
+// 32-bit depth is 7,372,800 bytes (7.03 MiB). Two of those in turn fill the frame and leave the rest of the EDRAM for
+// the resolve.
+inline constexpr std::uint32_t kEdramTileBytes = 7u * 1024u * 1024u;
+
+// ---- The picture -------------------------------------------------------------------------------------------------
+
+// 1280x720 is the console's own HD mode: the GPU's scaler puts it on a 1080p panel, and the EDRAM holds a 32-bit
+// colour target plus a 32-bit depth target at 2x multisampling in two predicated tiles (7.4 MB a tile, 512 KB of the
+// 10 MB spare for the resolve).
+inline constexpr int kFrameWidth = 1280;
+inline constexpr int kFrameHeight = 720;
+inline constexpr int kFrameHz = 60;
+inline constexpr int kMultisample = 2;
+inline constexpr bool kPredicatedTiling = true;
+
+// One frame: 16.67 ms. The game's own share of it, the renderer's submit, and what the display's refresh leaves.
+struct FrameBudget {
+    float game_ms;      // simulation, physics, animation, the game's own draws built
+    float submit_ms;    // command buffer recording and the kick
+    float audio_ms;     // one XAudio pull, on its own thread
+    float slack_ms;
+};
+inline constexpr FrameBudget kFrameBudget{10.5f, 4.0f, 0.8f, 1.3f};
+inline constexpr int kFrameBudgetMs = 16;  // the same, whole, for the frame limiter
+
+// ---- The memory split --------------------------------------------------------------------------------------------
+
+// 480 MB, in the order a frame touches it. A pool is sized once at boot and never grows: the console's allocator
+// fragments under a long session, and the game's own heap is the one that must not.
+struct MemorySplit {
+    std::uint32_t pak_stream_mb;   // the cooked pak's read-ahead and the disc/HDD streaming ring
+    std::uint32_t textures_mb;     // GPU-visible, D3DPOOL_DEFAULT: the scene's textures and the resolve targets
+    std::uint32_t geometry_mb;     // vertex and index buffers, static and per-frame
+    std::uint32_t audio_mb;        // music and effects, plus the XMA decoder's own buffers
+    std::uint32_t game_heap_mb;    // the game module and the host's own allocations
+    std::uint32_t shaders_mb;      // the compiled Xenos shader blobs and the state blocks
+    std::uint32_t spare_mb;
+};
+inline constexpr MemorySplit kMemory{192u, 128u, 48u, 36u, 68u, 4u, 4u};
+
+// ---- Threads -----------------------------------------------------------------------------------------------------
+
+// Core 0 thread 0 belongs to the kernel and the dashboard's guide: the port keeps off it. The two game threads (the
+// host and the game module's own worker) sit on core 2 apart from the renderer's submit, and audio has a core of its
+// own so a long frame cannot starve the mixer.
+struct ThreadPlan {
+    std::uint32_t game_processor;   // the frame's simulation
+    std::uint32_t game_helper;      // the game module's job thread
+    std::uint32_t render;           // command recording and the kick
+    std::uint32_t audio;            // the XAudio render driver
+    std::uint32_t streaming;        // pak reads and texture uploads
+};
+inline constexpr ThreadPlan kThreads{2u, 4u, 5u, 3u, 1u};
+
+// ---- Streaming ---------------------------------------------------------------------------------------------------
+
+// The disc peaks at about 12 MB/s on the outer edge, an installed hard disk at 60 MB/s. A pak read is a 64 KB request
+// with the next four queued behind it, so a level's textures arrive before the frame that wants them.
+inline constexpr std::uint32_t kReadChunkBytes = 64u * 1024u;
+inline constexpr std::uint32_t kReadQueueDepth = 5u;
+inline constexpr std::uint32_t kTextureUploadBytesPerFrame = 2u * 1024u * 1024u;
+
+// ---- The shader cache --------------------------------------------------------------------------------------------
+
+// Xenos runs Shader Model 3.0 vertex and pixel programs; the port's GX programs are the same HLSL compiled for it
+// (tools/dev/compile_programs.py --target xenos, on a Windows host with the SDK's ps_3_0/vs_3_0 compiler). One blob per
+// program and variant, in the package beside the game's data.
+inline constexpr const char* kShaderCacheFile = "programs.xsh";
+inline constexpr std::uint32_t kShaderBlobAlign = 128u;  // the Xenos's shader fetch wants a 128-byte boundary
+
+}  // namespace galaxy::host::x360
diff --git a/platform/xbox360/xenos_device.cpp b/platform/xbox360/xenos_device.cpp
new file mode 100644
index 0000000..f9bd94b
--- /dev/null
+++ b/platform/xbox360/xenos_device.cpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Xenos: the device, the EDRAM scene, the resolve and the present (xenos_device.h).
+//
+// The 360 speaks D3D9 with a handful of its own extensions: the driver keeps render targets in the daughter die's
+// 10 MB, a scene that does not fit is drawn in predicated tiles (BeginTiling/EndTiling), and a multisampled target is
+// resolved into a texture the scaler can read. Those extensions are the SDK's; a toolchain that spells them
+// differently changes these calls and nothing above them.
+#include "xenos_device.h"
+
+#include "xbox360_platform.h"
+#include "xbox360_tuning.h"
+
+#if defined(NEBULA_XBOX360)
+#include "xbox360_apis.h"
+
+#include <cstdio>
+
+namespace galaxy::host::x360 {
+namespace {
+
+D3DFORMAT format_of(TextureDesc::Format format) {
+    switch (format) {
+    case TextureDesc::Format::Bgra8:
+        return D3DFMT_A8R8G8B8;
+    case TextureDesc::Format::Bc1:
+        return D3DFMT_DXT1;
+    case TextureDesc::Format::Bc2:
+        return D3DFMT_DXT3;
+    case TextureDesc::Format::Bc3:
+    case TextureDesc::Format::Dxt5:
+        return D3DFMT_DXT5;
+    case TextureDesc::Format::Rgba8:
+        return D3DFMT_A8B8G8R8;
+    case TextureDesc::Format::R8:
+        return D3DFMT_L8;
+    }
+    return D3DFMT_A8R8G8B8;
+}
+
+std::uint32_t texel_bytes(TextureDesc::Format format) {
+    switch (format) {
+    case TextureDesc::Format::Bgra8:
+    case TextureDesc::Format::Rgba8:
+        return 4u;
+    case TextureDesc::Format::R8:
+        return 1u;
+    case TextureDesc::Format::Bc1:
+    case TextureDesc::Format::Bc2:
+    case TextureDesc::Format::Bc3:
+    case TextureDesc::Format::Dxt5:
+        return 0u;  // 4x4 blocks: the swizzle takes the block size, not a texel
+    }
+    return 4u;
+}
+
+}  // namespace
+
+struct XenosDevice::State {
+    IDirect3D9* d3d = nullptr;
+    IDirect3DDevice9* device = nullptr;
+    IDirect3DTexture9* color = nullptr;
+    IDirect3DSurface9* color_surface = nullptr;
+    IDirect3DTexture9* resolved = nullptr;
+    IDirect3DTexture9* depth = nullptr;
+    std::uint64_t presents = 0u;
+    bool tiling = false;
+    bool open = false;
+};
+
+XenosDevice::XenosDevice() : state_(std::make_unique<State>()) {}
+
+XenosDevice::~XenosDevice() { close(); }
+
+XenosDevice& xenos() {
+    static XenosDevice device;
+    return device;
+}
+
+bool XenosDevice::open() {
+    State& s = *state_;
+    if (s.open) {
+        return true;
+    }
+    s.d3d = Direct3DCreate9(D3D_SDK_VERSION);
+    if (s.d3d == nullptr) {
+        return false;
+    }
+    D3DPRESENT_PARAMETERS present{};
+    present.BackBufferWidth = static_cast<UINT>(kFrameWidth);
+    present.BackBufferHeight = static_cast<UINT>(kFrameHeight);
+    present.BackBufferFormat = D3DFMT_A8R8G8B8;
+    present.BackBufferCount = 2u;
+    present.MultiSampleType = static_cast<D3DMULTISAMPLE_TYPE>(kMultisample);
+    present.MultiSampleQuality = 0u;
+    present.SwapEffect = D3DSWAPEFFECT_DISCARD;
+    // A console has no window: the frame goes to the scaler, which fits it to the panel the dashboard selected.
+    present.Windowed = FALSE;
+    present.EnableAutoDepthStencil = TRUE;
+    present.AutoDepthStencilFormat = D3DFMT_D24S8;
+    present.PresentationInterval = D3DPRESENT_INTERVAL_ONE;
+    // The scaler's mode is the platform's (xbox360_platform.cpp); the device only renders 1280x720 into it.
+    if (FAILED(s.d3d->CreateDevice(D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, nullptr, D3DCREATE_HARDWARE_VERTEXPROCESSING,
+                                   &present, &s.device))) {
+        return false;
+    }
+    if (s.device->GetRenderTarget(0u, &s.color_surface) != D3D_OK) {
+        return false;
+    }
+    // The resolve target: the same size, one sample, the texture the scaler is handed.
+    if (s.device->CreateTexture(static_cast<UINT>(kFrameWidth), static_cast<UINT>(kFrameHeight), 1u,
+                                D3DUSAGE_RENDERTARGET, D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT, &s.resolved, nullptr) !=
+        D3D_OK) {
+        return false;
+    }
+    s.open = true;
+    x360::log_line(nullptr, "[xenos] device open: %dx%d, %dx multisample, predicated tiling %s", kFrameWidth,
+                   kFrameHeight, kMultisample, kPredicatedTiling ? "on" : "off");
+    return true;
+}
+
+void XenosDevice::close() {
+    State& s = *state_;
+    if (!s.open) {
+        return;
+    }
+    wait_idle();
+    if (s.resolved != nullptr) {
+        s.resolved->Release();
+        s.resolved = nullptr;
+    }
+    if (s.color_surface != nullptr) {
+        s.color_surface->Release();
+        s.color_surface = nullptr;
+    }
+    if (s.device != nullptr) {
+        s.device->Release();
+        s.device = nullptr;
+    }
+    if (s.d3d != nullptr) {
+        s.d3d->Release();
+        s.d3d = nullptr;
+    }
+    s.open = false;
+}
+
+bool XenosDevice::open_ok() const noexcept { return state_->open; }
+
+IDirect3DDevice9* XenosDevice::device() const noexcept { return state_->device; }
+
+IDirect3DTexture9* XenosDevice::resolved_texture() const noexcept { return state_->resolved; }
+
+void XenosDevice::begin_scene_tiles() {
+    State& s = *state_;
+    if (!kPredicatedTiling || s.device == nullptr || s.tiling) {
+        return;
+    }
+    D3DRECT whole{{0, 0, kFrameWidth, kFrameHeight}};
+    if (SUCCEEDED(s.device->BeginTiling(&whole, 0u))) {
+        s.tiling = true;
+    }
+}
+
+void XenosDevice::end_scene_tiles() {
+    State& s = *state_;
+    if (!s.tiling || s.device == nullptr) {
+        return;
+    }
+    s.device->EndTiling(0u);
+    s.tiling = false;
+}
+
+bool XenosDevice::resolve_and_present(bool vsync) {
+    State& s = *state_;
+    if (!s.open) {
+        return false;
+    }
+    if (s.tiling) {
+        end_scene_tiles();
+    }
+    if (SUCCEEDED(s.device->Resolve(D3DRESOLVE_RENDERTARGET0, nullptr, s.resolved, nullptr, 0u, 0u, nullptr, 1.0f,
+                                   0u, nullptr))) {
+        // The scaler presents the resolved texture; at a 60 Hz title Present ties the frame to the panel.
+        (void)vsync;
+        if (s.device->Present(nullptr, nullptr, nullptr, nullptr) == D3DERR_DEVICELOST) {
+            return false;
+        }
+        ++s.presents;
+        return true;
+    }
+    return false;
+}
+
+IDirect3DTexture9* XenosDevice::create_texture(const TextureDesc& desc) const {
+    State& s = *state_;
+    if (!s.open) {
+        return nullptr;
+    }
+    const DWORD usage = desc.render_target ? D3DUSAGE_RENDERTARGET : 0u;
+    IDirect3DTexture9* pTexture = nullptr;
+    if (FAILED(s.device->CreateTexture(desc.width, desc.height, desc.mips, usage, format_of(desc.format),
+                                       D3DPOOL_DEFAULT, &pTexture, nullptr))) {
+        return nullptr;
+    }
+    return pTexture;
+}
+
+bool XenosDevice::upload_texture(IDirect3DTexture9* pTexture, const TextureDesc& desc, const void* rows,
+                                 std::uint32_t pitch) const {
+    State& s = *state_;
+    if (!s.open || pTexture == nullptr || rows == nullptr) {
+        return false;
+    }
+    const std::uint32_t bytes = texel_bytes(desc.format);
+    std::uint32_t width = desc.width;
+    std::uint32_t height = desc.height;
+    const auto* pRows = static_cast<const unsigned char*>(rows);
+    for (std::uint32_t level = 0; level < desc.mips && level < 32u; ++level) {
+        D3DLOCKED_RECT locked{};
+        if (FAILED(pTexture->LockRect(level, &locked, nullptr, 0u))) {
+            return false;
+        }
+        // The blocks of a compressed level are its width and height in 4x4 cells.
+        const bool compressed = bytes == 0u;
+        const std::uint32_t w = compressed ? (width + 3u) / 4u : width;
+        const std::uint32_t h = compressed ? (height + 3u) / 4u : height;
+        const std::uint32_t texel = compressed ? 8u /* a 4x4 block of DXT1 */ : bytes;
+        api::XGSwizzleRect(pRows, pitch, nullptr, locked.pBits, w, h, nullptr, texel);
+        pTexture->UnlockRect(level);
+        // The next level follows the rows of this one.
+        pRows += static_cast<std::size_t>(pitch) * height;
+        width = width > 1u ? width / 2u : 1u;
+        height = height > 1u ? height / 2u : 1u;
+    }
+    return true;
+}
+
+void XenosDevice::wait_idle() {
+    State& s = *state_;
+    if (s.device == nullptr) {
+        return;
+    }
+    IDirect3DQuery9* pQuery = nullptr;
+    if (FAILED(s.device->CreateQuery(D3DQUERYTYPE_EVENT, &pQuery)) || pQuery == nullptr) {
+        return;
+    }
+    if (SUCCEEDED(pQuery->Issue(D3DISSUE_END))) {
+        // The GPU's own mark: the wait ends when it is reached, which is the queue empty.
+        while (pQuery->GetData(nullptr, 0u, D3DGETDATA_FLUSH) == S_FALSE) {
+            Sleep(0);
+        }
+    }
+    pQuery->Release();
+}
+
+std::uint64_t XenosDevice::presents() const noexcept { return state_->presents; }
+
+}  // namespace galaxy::host::x360
+
+#endif  // NEBULA_XBOX360
